# Runtime stays dependency-free. Build-only packages are locked for reproducible releases.
node_modules/
build/
dist/

# Secrets — ANTEATER_API_KEY belongs in the environment, never in the tree.
.env
.env.*
!.env.example

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp

# Local agent + tooling state
.claude/
*.log
