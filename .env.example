# Copy to `.env` and fill in. `.env` is gitignored; `.env.example` is not.
# Request a key at https://dashboard.anteaterapi.com/create — choose type "secret",
# because Node sends no Origin header and publishable keys are Origin-verified.
ANTEATER_API_KEY=

# Optional independent fallback for live WebSoc schedule queries. Defaults to
# the public Zotcourse deployment; set to "off" to disable the fallback.
ZOTCOURSE_API_BASE=https://zotcourse.appspot.com

# Required before exposing the HTTP or Docker deployment beyond loopback.
# Generate with: openssl rand -hex 24
ANTEATER_MCP_TOKEN=

# Optional. Which peers may set X-Forwarded-*. Required behind a reverse proxy, or the
# server ignores the headers and reports the proxy as the client. "private" covers the
# Docker bridge; "loopback" suits a server running directly on the host.
ANTEATER_TRUSTED_PROXIES=

# Optional. Override the upstream API, e.g. to point at a self-hosted instance.
ANTEATER_API_BASE=https://anteaterapi.com

# Optional. HTTP mode only. Comma-separated extra browser origins to accept.
ANTEATER_ALLOWED_ORIGINS=
