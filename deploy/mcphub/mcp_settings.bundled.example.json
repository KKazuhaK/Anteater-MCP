{
  "mcpServers": {
    "anteater-shared": {
      "type": "stdio",
      "owner": "admin",
      "visibility": "public",
      "idleTimeoutMs": 300000,
      "command": "/opt/mcp/bin/node24",
      "args": [
        "/opt/mcp/anteater/anteater-mcp.mjs"
      ],
      "env": {
        "ANTEATER_API_KEY": "${ANTEATER_SHARED_API_KEY}"
      }
    },
    "anteater-personal": {
      "type": "stdio",
      "owner": "admin",
      "visibility": "public",
      "idleTimeoutMs": 300000,
      "command": "/opt/mcp/bin/node24",
      "args": [
        "/opt/mcp/anteater/anteater-mcp.mjs"
      ],
      "credentialTemplate": [
        {
          "target": "env",
          "name": "ANTEATER_API_KEY",
          "label": "Your personal Anteater API secret key"
        }
      ]
    }
  }
}
